  // JobTracking Functions
  def jobStart(spark : SparkSession,
               env: String,
               jobName : String,
               subJobName : String,
               preRecCount : String,
               applicationName: String,
               product: String,
               emails : List[String],
               frequency : String,
               testRun : Boolean,
               logger : Logger
              ) : (Boolean, String, String, String, String) = {

    //    var jobStart = new CallJobStart

    var startFlag = false
    var jobId = ""
    var subJobId = ""
    var errorCode = ""
    var errorMsg = ""

    if (jobName != "Scalatest") {
      val jobStartRequest = JobStartRequestBody(
        jobName,
        subJobName,
        applicationName,
        product,
        preRecCount,
        ""
      )

      val jobStartOut =
        CallJobStart.jobStart(
          spark,
          env,
          jobStartRequest,
          emails,
          "Job Started",
          frequency,
          testRun)
      startFlag = jobStartOut._1
      jobId = jobStartOut._2
      subJobId = jobStartOut._3
      errorCode = jobStartOut._4
      errorMsg =  jobStartOut._5
    }

    if (!startFlag) {
      logger.error(s"Error calling jobStart for ${jobName}")
      logger.error(s"${errorCode} for jobID ${jobId}, subJobID ${subJobId}")
      logger.error(s"${errorCode} : ${errorMsg}")
      throw new Exception(s"Error calling jobStart ${jobId} : ${subJobId}")
    }

    (startFlag, jobId, subJobId, errorCode, errorMsg)

  }

  def jobEnd(spark : SparkSession,env : String,jobName : String,subJobName : String,extractts : String,postRecCount : String,emails : List[String], frequency : String, projectLocation : String, testRun : Boolean, logger: Logger, markCompleted : String = "N") : (Boolean, String, String, String, String) = {

    //    val jobEnd = new CallJobEnd

    var endFlag = false
    var jobId = ""
    var subJobId = ""
    var errorCode = ""
    var errorMsg = ""

    if (subJobName != "Scalatest") {

      val jobEndRequest = JobEndRequestBody(jobName,subJobName,extractts,postRecCount,markCompleted)

      val jobEndOut = {CallJobEnd.jobEnd(spark,env,jobEndRequest,emails,"Job Completed",frequency,testRun,projectLocation)}
      endFlag = jobEndOut._1
      jobId = jobEndOut._2
      subJobId = jobEndOut._3
      errorCode = jobEndOut._4
      errorMsg = jobEndOut._5
    }

    if (!endFlag) {

      logger.error(s"Error calling jobEnd for ${subJobName}")
      logger.error(s"${errorCode} for jobID ${jobId}, subJobID ${subJobId}")
      logger.error(s"${errorCode} : ${errorMsg}")
      throw new Exception(s"Error calling jobEnd ${jobId} : ${subJobId}")

    }

    (endFlag, jobId, subJobId, errorCode, errorMsg)

  }


  def jobFail(spark : SparkSession,
              env: String,
              jobName: String,
              subJobName : String,
              rejRecCount : String,
              errMsg : String,
              email : List[String],
              frequency : String,
              projectLocation : String,
              testRun: Boolean,
              logger: Logger) : (Boolean, String, String, String, String) = {

    //    val jobFail = new CallJobFail

    var failFlag = false
    var jobId = ""
    var subJobId = ""
    var errorCode = ""
    var errorMsg = ""


    if (subJobName != "Scalatest") {

      val jobFailRequest = JobFailRequestBody(
        jobName,
        subJobName,
        rejRecCount,
        subJobName,
        errMsg
      )

      val jobFailOut = {

        CallJobFail.jobFail(
          spark,
          env,
          jobFailRequest,
          email,
          "Job Failed",
          frequency,
          testRun ,
          projectLocation)
      }
      failFlag = jobFailOut._1
      jobId = jobFailOut._2
      subJobId = jobFailOut._3
      errorCode = jobFailOut._4
      errorMsg = jobFailOut._5

    }

    if (!failFlag && jobName != "Scalatest") {

      logger.error(s"Error calling jobEnd for ${subJobName}")
      logger.error(s"${errorCode} for jobID ${jobId}, subJobID ${subJobId}")
      logger.error(s"${errorCode} : ${errorMsg}")
      throw new Exception(s"Error calling jobFail ${jobId} : ${subJobId}")
    }

    (failFlag, jobId, subJobId, errorCode, errorMsg)
  }

  def getCustomDateTime(dateVal: String, dateTimeFormatDestination: String, dateTimeFormatSource: String): String = {
    val dateFormatSource = new SimpleDateFormat(dateTimeFormatSource)
    val pardt = dateFormatSource.parse(dateVal)
    val dateFormatDestination = new SimpleDateFormat(dateTimeFormatDestination)
    dateFormatDestination.format(pardt)
  }



